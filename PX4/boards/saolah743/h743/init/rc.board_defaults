#!/bin/sh
#
# Saolah743 board specific defaults
#------------------------------------------------------------------------------
# No onboard current sensor: current comes only from ESC connector pin 8
# (CURR -> 1K -> PC1, no pull-down). Without an ESC current output the pin
# floats and reads charge coupled from PC0 (VBAT), so the current and used
# capacity are not valid. Keep BAT1_CAPACITY at -1 so the remaining estimate
# is voltage based, and set BAT1_A_PER_V for the connected ESC.
param set-default BAT1_A_PER_V 40.2
param set-default BAT1_CAPACITY -1
param set-default BAT1_N_CELLS 4
param set-default BAT1_V_CHARGED 4.2
# BAT1_V_DIV = the real divider ratio (V_pin / V_ADC), NOT 21.12 as the
# original notes (hwdef-pin.md, inherited from an early ArduPilot hwdef.dat)
# said. 21.12 was never measured: the INAV team measured 10.93:1 on a sample
# board (nominal 11:1 divider, R = 10k:1k), 0.6% off, within resistor
# tolerance. With 21.12 the voltage reads almost twice the real value (a 3S
# pack shows 20-something volts). Verified over MAVLink on a real board: it
# reported 20.708 V, which converts with the correct ratio to ~10.72 V,
# plausible for a 3S pack under discharge.
param set-default BAT1_V_DIV 10.93
param set-default BAT1_V_EMPTY 3.2

param set-default SYS_HAS_MAG 1
param set-default PWM_MAIN_TIM0 -4
param set-default RC_INPUT_PROTO -1

param set-default IMU_GYRO_CUTOFF 80
param set-default MC_PITCHRATE_K 0.4
param set-default MC_ROLLRATE_K 0.35
param set-default MC_YAWRATE_K 1.2
param set-default MC_YAWRATE_MAX 360
param set-default MAV_TYPE 2
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
param set-default CBRK_SUPPLY_CHK 894281
