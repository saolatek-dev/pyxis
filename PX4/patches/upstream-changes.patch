diff --git a/src/drivers/barometer/dps310/DPS310.cpp b/src/drivers/barometer/dps310/DPS310.cpp
index a9e1f73a0d..977c0ba216 100644
--- a/src/drivers/barometer/dps310/DPS310.cpp
+++ b/src/drivers/barometer/dps310/DPS310.cpp
@@ -65,7 +65,22 @@ DPS310::~DPS310()
 int
 DPS310::init()
 {
-	if (RegisterRead(Register::ID) != Infineon_DPS310::REV_AND_PROD_ID) {
+	// The Product ID read can fail on the very first transfer after power-up
+	// (the chip needs up to 40 ms after VDD to answer). A single failed read
+	// leaves buf = 0 and looks like a Product_ID mismatch, so retry a few
+	// times before giving up -- same approach Betaflight uses for this part.
+	bool id_ok = false;
+
+	for (int retry = 0; retry < 5; retry++) {
+		if (RegisterRead(Register::ID) == Infineon_DPS310::REV_AND_PROD_ID) {
+			id_ok = true;
+			break;
+		}
+
+		usleep(100000);	// 100 milliseconds
+	}
+
+	if (!id_ok) {
 		PX4_ERR("Product_ID mismatch");
 		return PX4_ERROR;
 	}
@@ -249,7 +264,10 @@ uint8_t
 DPS310::RegisterRead(Register reg)
 {
 	uint8_t buf{};
-	_interface->read((uint8_t)reg, &buf, 1);
+
+	if (_interface->read((uint8_t)reg, &buf, 1) != PX4_OK) {
+		perf_count(_comms_errors);
+	}
 
 	return buf;
 }
