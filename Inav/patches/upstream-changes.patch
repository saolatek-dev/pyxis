--- a/src/main/drivers/accgyro/accgyro_bmi088.c
+++ b/src/main/drivers/accgyro/accgyro_bmi088.c
@@ -82,6 +82,27 @@
 #define REGG_FIFO_CONFIG_1 0x3E
 #define REGG_FIFO_DATA     0x3F
 
+// BMI088 gyro datasheet limit: SPI clock max 10 MHz (same cap ArduPilot's
+// hwdef.dat uses for both bmi088_a and bmi088_g on this chip). BUS_SPEED_FAST
+// is DIV4 off the SPI2/3/4 kernel clock; on STM32H7 that kernel clock is
+// PLL1Q (100-120 MHz depending on HSE/rev), so BUS_SPEED_FAST there works out
+// to ~25-30 MHz - 2.5-3x over spec. A target whose H7 clock config puts it in
+// that range should define BMI088_GYRO_MAX_SPI_SPEED to bring it back down
+// (BUS_SPEED_STANDARD, further lowered by SPI_SLOW_BUS_STANDARD_DIV16 if that
+// is also defined, matches the fix already verified for this bus's BMI270).
+#ifndef BMI088_GYRO_MAX_SPI_SPEED
+#define BMI088_GYRO_MAX_SPI_SPEED BUS_SPEED_FAST
+#endif
+
+// spiBusSetSpeed() writes the peripheral's MBR directly instead of storing a
+// per-device rate, and nothing re-applies it per transfer - so the whole SPI
+// instance runs at whatever the last initialised device asked for. bmi088AccInit()
+// runs after bmi088GyroInit(), which makes the acc rate the one that actually
+// governs both halves of the chip. Overriding only the gyro is therefore a no-op
+// (measured: gyro set to FAST still left SPI2_CFG1.MBR at the STANDARD divisor).
+#ifndef BMI088_ACC_MAX_SPI_SPEED
+#define BMI088_ACC_MAX_SPI_SPEED BUS_SPEED_STANDARD
+#endif
 
 static void bmi088GyroInit(gyroDev_t *gyro)
 {
@@ -99,7 +120,7 @@ static void bmi088GyroInit(gyroDev_t *gyro)
     busWrite(gyro->busDev, REGG_INT_CTRL, 0x80);
     delay(1);
 
-    busSetSpeed(gyro->busDev, BUS_SPEED_FAST);
+    busSetSpeed(gyro->busDev, BMI088_GYRO_MAX_SPI_SPEED);
 }
 
 static void bmi088AccInit(accDev_t *acc)
@@ -126,7 +147,7 @@ static void bmi088AccInit(accDev_t *acc)
     busWrite(acc->busDev, REGA_RANGE, 0x02);
     delay(1);
 
-    busSetSpeed(acc->busDev, BUS_SPEED_STANDARD);
+    busSetSpeed(acc->busDev, BMI088_ACC_MAX_SPI_SPEED);
 
     acc->acc_1G = 2048;
 }
